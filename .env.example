# PostgreSQL connection string (обязательно)
DATABASE_URL=postgresql://user:password@localhost:5432/tickets

# Max Bot token (обязательно)
MAX_BOT_TOKEN=your_max_bot_token_here

# Путь к лог-файлу (опционально, по умолчанию ticket_system.log / max_bot.log)
# LOG_FILE=/var/log/ticket_system.log

# Webhook confirmation code для Max Bot (опционально)
# MAX_CONFIRMATION_CODE=your_code_here

# LM Studio (опционально)
# LM_STUDIO_URL=http://192.168.0.38:1234/v1/chat/completions
# LM_API_TOKEN=sk-lm-...
# LLM_MODEL=qwen2.5-coder-1.5b-instruct-mlx
